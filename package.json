{
  "name": "linebreak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client; wait",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
