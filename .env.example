# ---- server (runtime) ----
# Port the HTTP + WebSocket server listens on (hosting platforms usually set this).
PORT=8787
# Bind address.
HOST=0.0.0.0
# Comma-separated browser origins allowed to open /ws. Empty = allow any origin.
# Set this when the frontend is hosted on a different domain, e.g. https://linebreak.example.com
ALLOWED_ORIGINS=
# Directory of the built client to serve. Default: client/dist
STATIC_DIR=
# Secret that marks the site's creator in lobbies (gold "制作者" badge).
# Open the site once with ?creator=<this value> in that browser. Empty = no creator badge.
CREATOR_KEY=
# ¥50 tips through Stripe Checkout. Empty = no tip button. Use sk_test_… to try it, sk_live_… to take real money.
STRIPE_SECRET_KEY=
# Secret that signs supporter tokens (the red name tag). Long random string. Keep it the same forever,
# or every supporter loses their tag. Empty = derived from STRIPE_SECRET_KEY.
SUPPORTER_SECRET=
# Origin for Stripe's return URLs, e.g. https://linebreak-2an9.onrender.com. Empty = the page's own origin.
PUBLIC_URL=
# Local testing only: fake payments without Stripe (ignored when NODE_ENV=production).
TIP_MOCK=

# ---- client (build time, only for split frontend/backend deploys) ----
# Backend origin when the frontend is hosted elsewhere, e.g. https://linebreak-api.fly.dev
VITE_SERVER_URL=
# Public origin used in invite links. Default: the page's own origin.
VITE_PUBLIC_URL=

# ---- local development ----
# Where the Vite dev server proxies /ws and /api.
DEV_SERVER_URL=http://localhost:8787
