# ---- server (runtime) ----
# Port the HTTP + WebSocket server listens on (hosting platforms usually set this).
PORT=8787
# Bind address.
HOST=0.0.0.0
# Comma-separated browser origins allowed to open /ws. Empty = allow any origin.
# Set this when the frontend is hosted on a different domain, e.g. https://linebreak.example.com
ALLOWED_ORIGINS=
# Directory of the built client to serve. Default: client/dist
STATIC_DIR=

# ---- client (build time, only for split frontend/backend deploys) ----
# Backend origin when the frontend is hosted elsewhere, e.g. https://linebreak-api.fly.dev
VITE_SERVER_URL=
# Public origin used in invite links. Default: the page's own origin.
VITE_PUBLIC_URL=

# ---- local development ----
# Where the Vite dev server proxies /ws and /api.
DEV_SERVER_URL=http://localhost:8787
